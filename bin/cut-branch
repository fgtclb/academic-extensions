#!/usr/bin/env bash

#
# cut-branch: cut a version branch of the academic-extensions mono repository.
#
# Given the name of the new version branch and the version the source branch
# moves on to, this drives the whole cut:
#
#   PHASE 1 (the new branch)
#     - push the commit of the source branch as the new branch
#     - branch cut-<branch> off it
#     - bin/set-version <current version> dev --source-branch=<branch>, which
#       keys the branch alias and the edit branch of every manual to it
#     - the --source-branch default of bin/set-version, bin/release and
#       bin/cut-branch becomes <branch>
#     - commit "[TASK] Prepare branch <branch>", push, open PR against the new
#       branch, wait for checks, admin-merge
#
#   PHASE 2 (the source branch)
#     - branch set-version-<next-version> off the source branch
#     - bin/set-version <next-version> dev
#     - the version example of bin/set-version and bin/release becomes
#       <next-version>
#     - commit "[TASK] Set version <next-version>", push, open PR, wait for
#       checks, admin-merge
#
# It ends with the list of what a cut needs beyond that. The version-applying
# work is delegated to bin/set-version, this script owns git and GitHub (gh).
#
# Safety model, the one of bin/release:
#   --dry-run   Print EVERYTHING, touch nothing (local and remote alike).
#   --execute   Actually perform the remote operations (git push, gh pr
#               create/checks/merge). WITHOUT --execute the local branch,
#               commit and set-version steps run for real but every remote
#               operation is only PRINTED.
#
# A new branch that already exists on origin at the commit of the source branch
# is taken as created: the push is skipped, so a branch created by hand, or a
# run stopped after that push, continues.
#
# Usage:
#   bin/cut-branch <branch> <next-version> [options]
#
#   <branch>          the new version branch, MAJOR or MAJOR.MINOR. The current
#                     version of the source branch has to lie inside it.
#   <next-version>    MAJOR.MINOR.PATCH the source branch moves on to, above
#                     the new branch and still inside a numeric source branch.
#
# Options:
#   --source-branch=<name>   branch the new one is cut from (default: main)
#   --dry-run                print the whole plan, change nothing
#   --execute                enable remote/irreversible operations
#   -h, --help               show this help
#

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
cd "${ROOT_DIR}"

SET_VERSION_BIN="${SCRIPT_DIR}/set-version"
BRANCH_VERSION_BIN="${ROOT_DIR}/Build/Scripts/composerBranchVersion.sh"
# The three scripts whose --source-branch default names the branch they live on.
DEFAULT_SCRIPTS=(bin/set-version bin/release bin/cut-branch)
# The two scripts that carry a version example inside the branch's version line.
EXAMPLE_SCRIPTS=(bin/set-version bin/release)

# ---------------------------------------------------------------------------
# Output helpers
# ---------------------------------------------------------------------------
DRY_RUN=0
EXECUTE=0

info()  { printf '\n>> %s\n' "$*"; }
note()  { printf '   %s\n' "$*"; }
warn()  { printf 'WARNING: %s\n' "$*" >&2; }
die()   { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

usage() {
    sed -n '3,/^$/p' "${BASH_SOURCE[0]}" | sed 's/^#\{0,1\} \{0,1\}//'
}

# Local, reversible operations: executed unless --dry-run.
run() {
    if [ "${DRY_RUN}" -eq 1 ]; then
        printf '   [dry-run]  %s\n' "$*"
        return 0
    fi
    printf '   [run]      %s\n' "$*"
    "$@"
}

# Remote / irreversible operations: executed ONLY with --execute (and not
# --dry-run). Otherwise merely printed.
run_remote() {
    if [ "${DRY_RUN}" -eq 1 ]; then
        printf '   [dry-run]  %s\n' "$*"
        return 0
    fi
    if [ "${EXECUTE}" -eq 0 ]; then
        printf '   [skipped]  (needs --execute) %s\n' "$*"
        return 0
    fi
    printf '   [remote]   %s\n' "$*"
    "$@"
}

# Invoke bin/set-version for a branch, forwarding --dry-run when appropriate.
run_set_version() {
    local version="$1" branch="$2"
    local -a cmd=("${SET_VERSION_BIN}" "${version}" dev "--source-branch=${branch}")
    if [ "${DRY_RUN}" -eq 1 ]; then
        cmd+=("--dry-run")
        printf '   [dry-run]  %s\n' "${cmd[*]}"
        "${cmd[@]}"
        return 0
    fi
    printf '   [run]      %s\n' "${cmd[*]}"
    "${cmd[@]}"
}

# Replace a line pattern in a file and assert how many lines changed.
replace_lines() {
    local file="$1" expression="$2" expected="$3" before changed
    if [ "${DRY_RUN}" -eq 1 ]; then
        printf '   [dry-run]  sed -i -E %s %s\n' "${expression}" "${file}"
        return 0
    fi
    printf '   [run]      sed -i -E %s %s\n' "${expression}" "${file}"
    before="$(cat "${file}")"
    sed -i -E "${expression}" "${file}"
    changed="$(diff <(printf '%s\n' "${before}") "${file}" | grep -c '^>' || true)"
    [ "${changed}" -eq "${expected}" ] \
        || die "${file}: expected ${expected} changed line(s), got ${changed}"
}

# The --source-branch default of the scripts: the variable and the help line.
set_default_branch() {
    local branch="$1" script
    for script in "${DEFAULT_SCRIPTS[@]}"; do
        replace_lines "${script}" \
            "s/^SOURCE_BRANCH=\"[^\"]*\"\$/SOURCE_BRANCH=\"${branch}\"/; s/^(#   --source-branch=<name> .*\\(default: )[^)]*\\)/\\1${branch})/" \
            2
    done
}

# The version example of the scripts, written as "e.g. <version>".
set_version_example() {
    local version="$1" example script count
    example="$(sed -n -E 's/^#   <version> .*e\.g\. ([0-9]+\.[0-9]+\.[0-9]+)$/\1/p' bin/set-version)"
    [ -n "${example}" ] || die "bin/set-version: no version example found in its help."
    for script in "${EXAMPLE_SCRIPTS[@]}"; do
        count="$(grep -c "e\\.g\\. ${example//./\\.}\\b" "${script}" || true)"
        [ "${count}" -gt 0 ] || die "${script}: the version example ${example} is missing."
        replace_lines "${script}" "s/e\\.g\\. ${example//./\\.}\\b/e.g. ${version}/g" "${count}"
    done
}

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------
NEW_BRANCH=""
NEXT_VERSION=""
SOURCE_BRANCH="main"

while [ $# -gt 0 ]; do
    case "$1" in
        --dry-run)          DRY_RUN=1 ;;
        --execute)          EXECUTE=1 ;;
        --source-branch=*)  SOURCE_BRANCH="${1#*=}" ;;
        --source-branch)    shift; SOURCE_BRANCH="${1:-}" ;;
        -h|--help)          usage; exit 0 ;;
        -*)                 die "Unknown option: $1 (see --help)" ;;
        *)
            if [ -z "${NEW_BRANCH}" ]; then
                NEW_BRANCH="$1"
            elif [ -z "${NEXT_VERSION}" ]; then
                NEXT_VERSION="$1"
            else
                die "Unexpected extra argument: $1 (see --help)"
            fi
            ;;
    esac
    shift
done

[ -n "${NEW_BRANCH}" ]   || die "Missing <branch> argument (see --help)"
[ -n "${NEXT_VERSION}" ] || die "Missing <next-version> argument (see --help)"

if [ "${DRY_RUN}" -eq 1 ] && [ "${EXECUTE}" -eq 1 ]; then
    die "--dry-run and --execute are mutually exclusive."
fi

# ---------------------------------------------------------------------------
# Validate the branch and the versions before anything is touched.
# ---------------------------------------------------------------------------
[[ "${NEW_BRANCH}" =~ ^[0-9]+(\.[0-9]+)?$ ]] \
    || die "Invalid branch '${NEW_BRANCH}': expected MAJOR or MAJOR.MINOR."
NEW_BRANCH_KEY="$("${BRANCH_VERSION_BIN}" "${NEW_BRANCH}")" \
    || die "Cannot derive the branch alias key of '${NEW_BRANCH}'."
SOURCE_BRANCH_KEY="$("${BRANCH_VERSION_BIN}" "${SOURCE_BRANCH}")" \
    || die "Cannot derive the branch alias key of '${SOURCE_BRANCH}'."
[ "${NEW_BRANCH}" != "${SOURCE_BRANCH}" ] || die "The new branch is the source branch."

[[ "${NEXT_VERSION}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] \
    || die "Invalid version '${NEXT_VERSION}': expected MAJOR.MINOR.PATCH."

# The current version of the source branch, the one the new branch continues.
CURRENT_VERSION=""
for file in packages/fgtclb/*/VERSION; do
    value="$(tr -d '[:space:]' < "${file}")"
    [ -n "${CURRENT_VERSION}" ] || CURRENT_VERSION="${value}"
    [ "${value}" = "${CURRENT_VERSION}" ] \
        || die "${file} carries ${value}, another package ${CURRENT_VERSION}: the versions have to agree."
done
[[ "${CURRENT_VERSION}" =~ ^([0-9]+\.[0-9]+\.[0-9]+)-dev$ ]] \
    || die "The source branch is on '${CURRENT_VERSION}', not on a dev version."
CURRENT_VERSION="${BASH_REMATCH[1]}"

[[ "${CURRENT_VERSION}." == "${NEW_BRANCH}."* ]] \
    || die "The current version ${CURRENT_VERSION} lies outside the new branch '${NEW_BRANCH}'."
[[ "${NEXT_VERSION}." != "${NEW_BRANCH}."* ]] \
    || die "The next version ${NEXT_VERSION} lies inside the new branch '${NEW_BRANCH}'."
[ "$(printf '%s\n%s\n' "${CURRENT_VERSION}" "${NEXT_VERSION}" | sort -V | tail -n 1)" = "${NEXT_VERSION}" ] \
    || die "The next version ${NEXT_VERSION} is below the current version ${CURRENT_VERSION}."
if [[ "${SOURCE_BRANCH_KEY}" != dev-* ]]; then
    [[ "${NEXT_VERSION}." == "${SOURCE_BRANCH_KEY%x-dev}"* ]] \
        || die "The next version ${NEXT_VERSION} lies outside the source branch '${SOURCE_BRANCH}'."
fi

CUT_BRANCH="cut-${NEW_BRANCH}"
CUT_COMMIT="[TASK] Prepare branch ${NEW_BRANCH}"
POST_BRANCH="set-version-${NEXT_VERSION}"
POST_COMMIT="[TASK] Set version ${NEXT_VERSION}"

# ---------------------------------------------------------------------------
# Resolve + verify tooling.
# ---------------------------------------------------------------------------
resolve_bin() {
    local var="$1" name="$2" path
    path="$(command -v "${name}" 2>/dev/null || true)"
    [ -n "${path}" ] || die "Required tool '${name}' not found on PATH."
    printf -v "${var}" '%s' "${path}"
}
resolve_bin GIT git
resolve_bin GH  gh
[ -x "${SET_VERSION_BIN}" ] || die "bin/set-version not found or not executable at ${SET_VERSION_BIN}"

# ---------------------------------------------------------------------------
# Mode banner
# ---------------------------------------------------------------------------
MODE="default (local runs, remote SKIPPED, needs --execute)"
[ "${DRY_RUN}" -eq 1 ] && MODE="dry-run (nothing is changed)"
[ "${EXECUTE}" -eq 1 ] && MODE="EXECUTE (remote operations WILL run)"

info "cut branch ${NEW_BRANCH} from ${SOURCE_BRANCH}"
note "new branch         : ${NEW_BRANCH} (${NEW_BRANCH_KEY}), continues ${CURRENT_VERSION}-dev"
note "cut branch         : ${CUT_BRANCH}   commit \"${CUT_COMMIT}\""
note "source branch      : ${SOURCE_BRANCH} (${SOURCE_BRANCH_KEY}), moves on to ${NEXT_VERSION}-dev"
note "set-version branch : ${POST_BRANCH}   commit \"${POST_COMMIT}\""
note "mode               : ${MODE}"

# ---------------------------------------------------------------------------
# Pre-flight guards. A dirty tree is fatal unless this is a dry run, because
# the default mode already checks out and commits.
# ---------------------------------------------------------------------------
info "Pre-flight checks"
"${GIT}" rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "Not inside a git work tree."

if [ -n "$("${GIT}" status --porcelain)" ]; then
    [ "${DRY_RUN}" -eq 1 ] || die "Working tree is not clean. Commit or stash it before cutting a branch."
    warn "Working tree is not clean (tolerated because this is a dry run)."
else
    note "working tree clean: ok"
fi

for branch in "${NEW_BRANCH}" "${CUT_BRANCH}" "${POST_BRANCH}"; do
    if "${GIT}" rev-parse -q --verify "refs/heads/${branch}" >/dev/null 2>&1; then
        die "Local branch '${branch}' already exists."
    fi
done
note "no local branch ${NEW_BRANCH}, ${CUT_BRANCH} or ${POST_BRANCH}: ok"

# ---------------------------------------------------------------------------
# Refresh the source branch.
# ---------------------------------------------------------------------------
info "Refresh source branch '${SOURCE_BRANCH}'"
run "${GIT}" checkout "${SOURCE_BRANCH}"
run_remote "${GIT}" fetch --all --prune
run_remote "${GIT}" pull --rebase
SOURCE_SHA="$("${GIT}" rev-parse "${SOURCE_BRANCH}")"
note "source commit      : ${SOURCE_SHA}"

REMOTE_SHA="$("${GIT}" ls-remote --heads origin "refs/heads/${NEW_BRANCH}" 2>/dev/null | cut -f1 || true)"
if [ -n "${REMOTE_SHA}" ] && [ "${REMOTE_SHA}" != "${SOURCE_SHA}" ]; then
    die "Branch '${NEW_BRANCH}' exists on origin at ${REMOTE_SHA}, not at the source commit."
fi

# ---------------------------------------------------------------------------
# PHASE 1: the new branch
# ---------------------------------------------------------------------------
info "PHASE 1: create ${NEW_BRANCH}"
if [ -n "${REMOTE_SHA}" ]; then
    note "branch ${NEW_BRANCH} exists on origin at the source commit, push skipped"
else
    run_remote "${GIT}" push origin "${SOURCE_SHA}:refs/heads/${NEW_BRANCH}"
fi

info "PHASE 1: prepare ${NEW_BRANCH}"
run "${GIT}" checkout -b "${CUT_BRANCH}" "${SOURCE_SHA}"
run_set_version "${CURRENT_VERSION}" "${NEW_BRANCH}"
set_default_branch "${NEW_BRANCH}"
run "${GIT}" add -A
run "${GIT}" commit -m "${CUT_COMMIT}"

info "PHASE 1: publish (remote)"
run_remote "${GIT}" push -u origin "${CUT_BRANCH}"
run_remote "${GH}" pr create --fill --base "${NEW_BRANCH}" --title "${CUT_COMMIT}"
run_remote sleep 10
run_remote "${GH}" pr checks --watch --interval 10 --fail-fast
run_remote sleep 10
run_remote "${GH}" pr merge --rebase --delete-branch --admin
run_remote "${GIT}" remote prune origin

# ---------------------------------------------------------------------------
# PHASE 2: the source branch moves on
# ---------------------------------------------------------------------------
info "PHASE 2: set version ${NEXT_VERSION} on ${SOURCE_BRANCH}"
run "${GIT}" checkout "${SOURCE_BRANCH}"
run "${GIT}" checkout -b "${POST_BRANCH}" "${SOURCE_SHA}"
run_set_version "${NEXT_VERSION}" "${SOURCE_BRANCH}"
set_version_example "${NEXT_VERSION}"
run "${GIT}" add -A
run "${GIT}" commit -m "${POST_COMMIT}"

info "PHASE 2: publish (remote)"
run_remote "${GIT}" push -u origin "${POST_BRANCH}"
run_remote "${GH}" pr create --fill --base "${SOURCE_BRANCH}" --title "${POST_COMMIT}"
run_remote sleep 10
run_remote "${GH}" pr checks --watch --interval 10 --fail-fast
run_remote sleep 10
run_remote "${GH}" pr merge --rebase --delete-branch --admin
run_remote "${GIT}" remote prune origin

info "Finished cutting ${NEW_BRANCH} (${SOURCE_BRANCH} moves on to ${NEXT_VERSION}-dev)"
if [ "${EXECUTE}" -eq 0 ] && [ "${DRY_RUN}" -eq 0 ]; then
    note "Remote operations were SKIPPED. Re-run with --execute to publish."
fi

info "Left to do by hand"
note "- GitHub ruleset 'version-branches': add refs/heads/${NEW_BRANCH}, it protects"
note "  the branch against deletion and force pushes."
note "- .github/workflows/nightly.yml on the default branch: add ${NEW_BRANCH} to the"
note "  branches it dispatches, if it is maintained."
note "- DDEV project names of ${SOURCE_BRANCH} (core-*/.ddev/config.yaml) and the docs,"
note "  README and DdevWorktreeNamesTest that name them."
note "- The version line prose on both branches: README version tables, AGENTS.md,"
note "  docs/Index.md, docs/workflow/backporting.md, openspec/config.yaml."
note "- The TYPO3 core versions ${SOURCE_BRANCH} supports from ${NEXT_VERSION} on."
note "- YouTrack version values, and Packagist listing ${NEW_BRANCH_KEY} for every"
note "  split package once the splitter carried the branch over."
