plugin.tx_academicbitejobs {
  settings {
    # The content element layout renders the header of every content element, so the
    # template renders it only for a site whose layout leaves it out. The header partial
    # falls back to the type of the header layout "Default" through the setting below,
    # which plugin settings do not carry the way the settings of `lib.contentElement` do.
    renderContentElementHeader = {$plugin.tx_academicbitejobs.renderContentElementHeader}
    defaultHeaderType = {$styles.content.defaultHeaderType}
  }
  view {
    templateRootPaths {
      10 = EXT:academic_bite_jobs/Resources/Private/Templates/
      20 = {$plugin.tx_academicbitejobs.view.templateRootPath}
    }
    partialRootPaths {
      0 = EXT:fluid_styled_content/Resources/Private/Partials/
      10 = EXT:academic_bite_jobs/Resources/Private/Partials/
      20 = {$plugin.tx_academicbitejobs.view.partialRootPath}
    }
    layoutRootPaths {
      10 = EXT:academic_bite_jobs/Resources/Private/Layouts/
      20 = {$plugin.tx_academicbitejobs.view.layoutRootPath}
    }
  }
}
