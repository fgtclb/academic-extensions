plugin.tx_academicbitejobs {
    # cat=plugin.tx_academicbitejobs//a; type=boolean; label=Render the content element header in the plugin: only for a site whose content element layout renders no header
    renderContentElementHeader = 0

    view {
        # cat=plugin.tx_academicjobs_createjob/file; type=string; label=Path to template root (FE)
        templateRootPath = EXT:academic_bite_jobs/Resources/Private/Templates/BiteJobs/
        # cat=plugin.tx_academicjobs_createjob/file; type=string; label=Path to template partials (FE)
        partialRootPath = EXT:academic_bite_jobs/Resources/Private/Partials/BiteJobs/
        # cat=plugin.tx_academicjobs_createjob/file; type=string; label=Path to template layouts (FE)
        layoutRootPath = EXT:academic_bite_jobs/Resources/Private/Layouts/BiteJobs/
    }
}
