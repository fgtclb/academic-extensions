# Page TSconfig of the InlineProfile content element.
#
# The content element is hidden globally by "Configuration/page.tsconfig" and
# enabled only on sites or page trees which include this component.
TCEFORM.tt_content.CType.removeItems := removeFromList(academicpersonsedit_inlineprofile)

mod.wizards.newContentElement.wizardItems.academic {
  elements {
    academicpersonsedit_inlineprofile {
      iconIdentifier = persons_edit_icon
      title = LLL:EXT:academic_persons_edit/Resources/Private/Language/locallang_be.xlf:plugin.profile_inlineediting.label
      description = LLL:EXT:academic_persons_edit/Resources/Private/Language/locallang_be.xlf:plugin.profile_inlineediting.description
      tt_content_defValues {
        CType = academicpersonsedit_inlineprofile
      }
    }
  }
}
