plugin.tx_academiccontacts4pages {
  # cat=plugin.tx_academiccontacts4pages//a; type=boolean; label=Render the content element header in the contacts list: only for a site whose content element layout renders no header
  renderContentElementHeader = 0

  view {
    # cat=plugin.tx_academiccontacts4pages/file; type=string; label=Path to template root (FE)
    templateRootPath = EXT:academic_contacts4pages/Resources/Private/Templates/
    # cat=plugin.tx_academiccontacts4pages/file; type=string; label=Path to template partials (FE)
    partialRootPath = EXT:academic_contacts4pages/Resources/Private/Partials/
    # cat=plugin.tx_academiccontacts4pages/file; type=string; label=Path to template layouts (FE)
    layoutRootPath = EXT:academic_contacts4pages/Resources/Private/Layouts/
  }
}
