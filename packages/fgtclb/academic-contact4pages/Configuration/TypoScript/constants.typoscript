# Deprecated since 2.4, removed in 4.0.
#
# The constants of the static template path this extension offered up to
# version 2.3, see "setup.typoscript" next to this file.
#
# Version 2.3 had no constants file here. The setup reads constants now, so a
# site package that imports "setup.typoscript" by path has to import this file
# into its constants as well.
@import 'EXT:academic_contacts4pages/Configuration/TypoScript/List/constants.typoscript'
