# A site package that renders the header of the contacts element in its own list template,
# through the header partial of EXT:fluid_styled_content, rather than in the layout of the
# element - so the header renders once. The path of that partial and the default header
# type come with the extension.
tt_content.academiccontacts4pages_list.layoutRootPaths.50 = EXT:academic_contacts4pages/Tests/Functional/Plugins/Fixtures/Layouts/

plugin.tx_academiccontacts4pages.view.templateRootPaths.20 = EXT:academic_contacts4pages/Tests/Functional/Plugins/Fixtures/Templates/
