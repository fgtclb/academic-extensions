# Deprecated since 2.4, removed in 4.0.
#
# The static template path this extension offered up to version 2.3. It is
# stored in TypoScript records and imported by site packages, so it keeps
# delivering what "All components" delivers, and nothing else. Select
# "Academic Study Plan: All components", or depend on the site set, instead.
#
# In version 2.3 this folder also added the stylesheet and the script of the
# content element to every page. The content element template registers them
# itself now, switchable with "plugin.tx_academicstudyplan.assets.*".
@import 'EXT:academic_study_plan/Configuration/TypoScript/ContentElement/setup.typoscript'
