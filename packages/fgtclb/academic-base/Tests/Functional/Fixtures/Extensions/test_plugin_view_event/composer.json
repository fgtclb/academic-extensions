{
    "name": "tests/test-plugin-view-event",
    "description": "Extension listening to the plugin view event of academic_base in every academic plugin, and recording the plugin context of every event",
    "type": "typo3-cms-extension",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Stefan Bürk",
            "email": "stefan@buerk.tech",
            "role": "Maintainer"
        }
    ],
    "require": {
        "typo3/cms-core": "~13.4.0@dev || ~14.3.6@dev",
        "fgtclb/academic-base": "~3.0.0@dev",
        "fgtclb/academic-bite-jobs": "~3.0.0@dev",
        "fgtclb/academic-contacts4pages": "~3.0.0@dev",
        "fgtclb/academic-jobs": "~3.0.0@dev",
        "fgtclb/academic-partners": "~3.0.0@dev",
        "fgtclb/academic-persons": "~3.0.0@dev",
        "fgtclb/academic-programs": "~3.0.0@dev",
        "fgtclb/academic-projects": "~3.0.0@dev"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "test_plugin_view_event",
            "version": "3.0.0-dev",
            "Package": {
                "providesPackages": []
            }
        }
    },
    "autoload": {
        "psr-4": {
            "TESTS\\TestPluginViewEvent\\": "Classes/"
        }
    }
}
