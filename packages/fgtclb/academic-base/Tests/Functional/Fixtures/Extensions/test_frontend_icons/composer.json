{
    "name": "tests/frontend-icons",
    "description": "Icons registered for the frontend icon registry of academic_base, from a file and from a listener",
    "type": "typo3-cms-extension",
    "license": "GPL-2.0-or-later",
    "require": {
        "typo3/cms-core": "~13.4.35 || ~14.3.7",
        "fgtclb/academic-base": "~3.0.0@dev"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "test_frontend_icons",
            "version": "3.0.0-dev",
            "Package": {
                "providesPackages": []
            }
        }
    },
    "autoload": {
        "psr-4": {
            "TESTS\\FrontendIcons\\": "Classes/"
        }
    }
}
