plugin.tx_academicprojects {
  view {
    templateRootPath = EXT:academic_projects/Resources/Private/Templates/
    partialRootPath = EXT:academic_projects/Resources/Private/Partials/
    layoutRootPath = EXT:academic_projects/Resources/Private/Layouts/
  }

  # Also a site setting of the set "fgtclb/academic-projects", with the same default -
  # see "Configuration/Sets/Full/settings.definitions.yaml".
  # cat=plugin.tx_academicprojects//a; type=boolean; label=Render the content element header in the project lists: only for a site whose content element layout renders no header
  renderContentElementHeader = 0

  # The page of the project page type. Declared for site sets in
  # "Configuration/Sets/Full/settings.definitions.yaml" with the same default.
  page {
    # cat=plugin.tx_academicprojects/page; type=string; label=Page layout of project pages: the Fluid layout the project page renders its section "Main" into
    layout = Default
  }

  # The category filters of the project lists. Also site settings of the set
  # "fgtclb/academic-projects", with the same defaults - see
  # "Configuration/Sets/Full/settings.definitions.yaml".
  filter {
    # cat=plugin.tx_academicprojects/filter; type=string; label=Filter types: comma-separated category type identifiers of the group "projects", in the order the filter form offers them; empty offers every type with categories
    categoryTypes =
    # cat=plugin.tx_academicprojects/filter; type=int+; label=Visible filters: how many filters are shown right away, the others behind "More filters"; 0 shows every filter
    visibleCount = 0
    # cat=plugin.tx_academicprojects/filter; type=boolean; label=Hide options without results: leave out the categories no listed project carries instead of showing them disabled
    hideDisabledOptions = 0
    # cat=plugin.tx_academicprojects/filter; type=boolean; label=Active filter tags: one link per selected filter above a project list, which removes that filter
    showActiveFilters = 0
    # cat=plugin.tx_academicprojects/filter; type=boolean; label=Reset link: a link back to the project list as the content element presets it, shown while the visitor has filtered
    showReset = 0
    # cat=plugin.tx_academicprojects/filter; type=boolean; label=Result count: the number of projects found
    showResultCount = 0
  }
}
