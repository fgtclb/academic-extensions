# Page TSconfig of the project list content element.
#
# Delivered by the set "fgtclb/academic-projects-project-list" and
# registered for the page field "Page TSconfig" by
# "Configuration/TCA/Overrides/pages.php" - one physical copy, two ways to it.
#
# The content element is hidden for the whole installation by
# "Configuration/page.tsconfig"; this file is what makes it selectable again,
# so it applies where the component is actually wanted instead of everywhere.
TCEFORM.tt_content.CType.removeItems := removeFromList(academicprojects_projectlist)

mod.wizards.newContentElement.wizardItems.academic {
  elements {
    academicprojects_projectlist {
      iconIdentifier = actions-code-merge
      title = LLL:EXT:academic_projects/Resources/Private/Language/locallang_be.xlf:plugin.project_list.name
      description = LLL:EXT:academic_projects/Resources/Private/Language/locallang_be.xlf:plugin.project_list.description
      tt_content_defValues {
        CType = academicprojects_projectlist
      }
    }
  }
}
