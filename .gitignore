.DS_Store
/.idea/

# Working tree of AI coding agents: plans, reports, commit drafts and scratch
# files. See AGENTS.md — nothing below it is ever committed.
/.agent

# Agent tool configuration and personal, machine-local instructions.
/.claude
/AGENTS.local.md
/CLAUDE.local.md
/GEMINI.local.md

/var/
/vendor/
/.Build/
# Composer download and phpstan result cache. Deliberately outside ".Build/",
# because "runTests.sh -s composerUpdate" starts with "rm -rf .Build" and would
# otherwise throw the cache away on every dependency install.
/.cache/

# Dependency tree of the frontend asset build. The compiled artifacts below the
# packages' "Resources/Public/" are committed, this is not: neither composer nor
# a TER upload runs a node build, so the result has to ship while its sources and
# tooling do not. The npm cache lands in "/.cache/npm", ignored above.
/Build/node_modules

/composer.json.orig
/composer.json.testing
/composer.lock
/.php-cs-fixer.cache
/rector.php
*.diff

# Composer writes its cache relative to the directory given with "-d", so
# "bin/set-version" and any manual "composer -d <package>" leaves one behind.
/packages-dev/*/.cache/
/packages/*/*/.cache/

# Development instances. "config/" and "composer.lock" are tracked now: the
# instance ships its own system configuration and a locked dependency set, and
# is seeded from "sqlite-databases/". Only generated trees are ignored, plus the
# "config/system/additional/" drop-in folder for local-only overrides (for
# example when the instance is served by a host stack instead of DDEV) and the
# ".no-database-seed" marker that suppresses the seeding while an instance is
# being rebuilt from nothing.
/core-13/.cache/
/core-13/.no-database-seed
/core-13/config/system/additional/*.php
/core-13/public/
/core-13/var/
/core-13/vendor/

/core-14/.cache/
/core-14/.no-database-seed
/core-14/config/system/additional/*.php
/core-14/public/
/core-14/var/
/core-14/vendor/

# The router certificate, its private key and the router configuration DDEV
# generates per project. DDEV ignores them itself - it rewrites ".ddev/.gitignore"
# on every start - but it lists them by the *current* project name only. The
# project names differ per version line ("core13-academics-v3" here,
# "core13-academics-v2" on branch "2"), so switching branches and running
# "ddev stop --unlist <other name>" leaves the other name's certificate behind,
# outside DDEV's own list and visible in "git status". Nothing below this
# directory is ever committed, whatever it is named: a private key least of all.
/core-13/.ddev/traefik/
/core-14/.ddev/traefik/

# The instance of the *other* version line. Branch "2" carries "core-12/" and
# "core-13/"; this branch carries "core-13/" and "core-14/". Switching branches
# in one checkout removes the tracked files of "core-12/" but leaves its ignored
# trees - "vendor/", "var/", "public/" and whatever DDEV generated - so the
# folder stays behind as untracked noise. It is ignored here for the same reason
# branch "2" ignores "core-14/".
/core-12/

# Generated by the functional test bootstrap; temporary until the
# typo3/testing-framework bugfix that avoids emitting it is released.
/packages/autoload-tests/

/tailor-version-artefact/
/tailor-version-upload/
/documentation-rendered/
