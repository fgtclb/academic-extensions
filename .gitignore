.DS_Store
/.idea/

# Working tree of AI coding agents: plans, reports, commit drafts and scratch
# files. See AGENTS.md — nothing below it is ever committed.
/.agent

# Agent tool configuration and personal, machine-local instructions.
/.claude
/AGENTS.local.md
/CLAUDE.local.md
/GEMINI.local.md
/var/
/vendor/
/.Build/
# Composer download and phpstan result cache. Deliberately outside ".Build/",
# because "runTests.sh -s composerUpdate" starts with "rm -rf .Build" and would
# otherwise throw the cache away on every dependency install.
/.cache/
/composer.json.orig
/composer.json.testing
/composer.lock
/.php-cs-fixer.cache
/rector.php
*.diff

# Composer writes its cache relative to the directory given with "-d", so
# "bin/set-version" and any manual "composer -d <package>" leaves one behind.
/packages-dev/*/.cache/
/packages/*/*/.cache/

# Development instances. "config/" and "composer.lock" are tracked now: the
# instance ships its own system configuration and a locked dependency set, and
# is seeded from "sqlite-databases/". Only generated trees are ignored, plus the
# "config/system/additional/" drop-in folder for local-only overrides (for
# example when the instance is served by a host stack instead of DDEV).
/core-12/.cache/
/core-12/config/system/additional/*.php
/core-12/public/
/core-12/var/
/core-12/vendor/

/core-13/.cache/
/core-13/config/system/additional/*.php
/core-13/public/
/core-13/var/
/core-13/vendor/

# Generated by the functional test bootstrap; temporary until the
# typo3/testing-framework bugfix that avoids emitting it is released.
/packages/autoload-tests/

/tailor-version-artefact/
/tailor-version-upload/
/documentation-rendered/
