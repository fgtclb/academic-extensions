{
    "name": "fgtclb/academic-extensions-core-12",
    "description": "TYPO3 v12 development instance for the academic extension mono repository",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "FGTCLB GmbH",
            "email": "hello@fgtclb.com"
        }
    ],
    "require": {
        "php": "^8.1 || ^8.2 || ^8.3 || ^8.4",
        "bk2k/bootstrap-package": "^15.0@dev",
        "fgtclb/academics-monorepo-dev-site": "~2.4.0@dev",
        "fgtclb/academics-monorepo-shared": "~2.4.0@dev",
        "sbuerk/extended-path-repository": "^1.1.0",
        "sbuerk/theme-extension-development": "^1.0.0@dev",
        "typo3/cms-adminpanel": "~12.4.0@dev",
        "typo3/cms-dashboard": "~12.4.0@dev",
        "typo3/cms-form": "~12.4.0@dev",
        "typo3/cms-impexp": "~12.4.0@dev",
        "typo3/cms-indexed-search": "~12.4.0@dev",
        "typo3/cms-linkvalidator": "~12.4.0@dev",
        "typo3/cms-opendocs": "~12.4.0@dev",
        "typo3/cms-reactions": "~12.4.0@dev",
        "typo3/cms-seo": "~12.4.0@dev",
        "typo3/cms-styleguide": "^12.0",
        "typo3/cms-viewpage": "~12.4.0@dev",
        "typo3/cms-webhooks": "~12.4.0@dev",
        "typo3/minimal": "^12"
    },
    "require-dev": {
        "vaimo/composer-patches": "^6.0.1"
    },
    "config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true,
            "php-http/discovery": true,
            "sbuerk/extended-path-repository": true,
            "sbuerk/fixture-packages": true,
            "vaimo/composer-patches": true
        },
        "sort-packages": true,
        "audit": {
            "block-insecure": false
        }
    },
    "extra": {
        "typo3/cms": {
            "web-dir": "public"
        },
        "patches-search": "patches/"
    },
    "repositories": {
        "packages-dev": {
            "type": "path",
            "url": "../packages-dev/*"
        },
        "packages": {
            "type": "path",
            "url": "../packages/*/*"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "support": {
        "issues": "https://github.com/fgtclb/academic-extensions/issues",
        "source": "https://github.com/fgtclb/academic-extensions",
        "email": "hello@fgtclb.com"
    },
    "homepage": "https://www.fgtclb.com/",
    "scripts": {
        "instance:fresh": [
            "@php ../Build/Scripts/instanceDatabase.php fresh"
        ],
        "instance:seed": [
            "@php vendor/bin/typo3 theme:seed EXT:academics_dev_site/Configuration/Seeds/Instance.yaml"
        ],
        "sqlite:apply": [
            "@php ../Build/Scripts/sqliteSnapshot.php restore ../sqlite-databases/core-12.sqlite var/sqlite/core-12.sqlite",
            "@php ../Build/Scripts/instanceDatabase.php seeded",
            "@php vendor/bin/typo3 cache:flush",
            "@php vendor/bin/typo3 cache:warmup"
        ],
        "sqlite:backup": [
            "@php vendor/bin/typo3 cache:flush",
            "@php ../Build/Scripts/sqliteSnapshot.php backup var/sqlite/core-12.sqlite ../sqlite-databases/core-12.sqlite",
            "@php vendor/bin/typo3 cache:warmup"
        ],
        "system:refresh": [
            "@php vendor/bin/typo3 cache:flush",
            "@php vendor/bin/typo3 cache:warmup",
            "@php vendor/bin/typo3 language:update",
            "@php vendor/bin/typo3 extension:setup"
        ]
    },
    "scripts-descriptions": {
        "instance:fresh": "Drop this instance's database and stop the automatic seeding, so it can be rebuilt from nothing.",
        "instance:seed": "Write the page tree, content and records of \"packages-dev/dev-site\" into this instance. Needs an empty page tree.",
        "sqlite:apply": "Restore this instance from \"../sqlite-databases/core-12.sqlite\", discarding its current database.",
        "sqlite:backup": "Copy this instance's database to \"../sqlite-databases/core-12.sqlite\" so it can be committed.",
        "system:refresh": "Refresh the system after changes: flush and warm up caches (DI), update languages, run extension setup."
    }
}
