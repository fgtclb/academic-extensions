# The static template of the "/legacy/" tree: the page object, and the
# stylesheet of the development instances.
#
# Two files rather than one, because the "/" tree takes them apart. Its theme is
# EXT:bootstrap_package, so it does not get the page object, and it gets the
# stylesheet through the set "fgtclb/academics-dev-site-stylesheet" its site
# configuration names. "LegacyDeliveryTest" swaps the theme for the set
# "fgtclb/academics-dev-site-page-object", which imports the page object alone:
# the stylesheet of the "/" side of that test then comes from the site
# configuration, as it does in the instance.
@import 'EXT:academics_dev_site/Configuration/TypoScript/PageObject.typoscript'
@import 'EXT:academics_dev_site/Configuration/TypoScript/Stylesheet.typoscript'
