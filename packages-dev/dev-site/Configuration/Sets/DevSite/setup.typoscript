# Page templates for the custom page types of the academic extensions.
#
# EXT:academic_programs and EXT:academic_partners each add a page type and a
# page template for it - "Resources/Private/Pages/AcademicProgram.html" and
# "AcademicPartner.html" - and add that directory to the template root paths
# under a condition on the page type. What they do not do is set the template
# *name*, which is the site package's business.
#
# With bk2k/bootstrap-package the name is derived from the backend layout:
#
#     templateName.cObject = TEXT
#     templateName.cObject { data = pagelayout  case = uppercamelcase
#                            split { token = pagets__  cObjNum = 1  1.current = 1 } }
#
# and "uppercamelcase" is "GeneralUtility::underscoredToUpperCamelCase()", which
# lowercases the whole string before it camel cases it on underscores. The
# backend layout the extensions register is "AcademicProgram", so the derived
# name is "Academicprogram" and the frontend dies with
# "InvalidTemplateResourceException: Tried resolving a template file for
# controller action Default->Academicprogram".
#
# Setting the name explicitly per page type fixes the frontend and leaves the
# backend layout alone, which is the one place the registered spelling is right.

[page && traverse(page, "doktype") == 20]
page.10.templateName >
page.10.templateName = AcademicProgram
[END]

[page && traverse(page, "doktype") == 40]
page.10.templateName >
page.10.templateName = AcademicPartner
[END]
